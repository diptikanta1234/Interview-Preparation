import os
from google import genai

def main():
    print("=================================================================")
    print("1st api call...")
    print("=================================================================")
    
    # The client automatically looks for the GEMINI_API_KEY environment variable
    client = genai.Client()

    print("-----------------------------------------------------------------")
    print("Experiment1------------------------")
    print("@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@")
    
    response1 = client.models.generate_content(
        model="gemini-2.5-flash",
        contents="What is Kubernetes and what's its use?",
    )
    
    # Print the text response from the model
    print(response1.text)
    
    print("\n" + "="*65)
    print("TOKEN USAGE METRICS")
    print("="*65)
    
    # Access usage metadata from the response object
    usage_metadata = response1.usage_metadata
    
    print(f"Prompt Tokens:    {usage_metadata.prompt_token_count}")
    print(f"Response Tokens:  {usage_metadata.candidates_token_count}")
    print(f"Total Tokens:     {usage_metadata.total_token_count}")
    print("="*65)

if __name__ == "__main__":
    main()


